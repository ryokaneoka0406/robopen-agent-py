SLACK_BOT_TOKEN=xoxb-***
SLACK_APP_TOKEN=xapp-***
# Optional: override codex binary path/alias
CODEX_CMD=codex
# Optional: allow Codex to write inside CODEX_WORKSPACE_DIR
CODEX_WORKSPACE_DIR=workspace
CODEX_SANDBOX=workspace-write
CODEX_DANGEROUSLY_BYPASS_APPROVALS_AND_SANDBOX=false
CODEX_SKIP_GIT_REPO_CHECK=false
# Optional: SQLite database path
SQLITE_PATH=data/agent.db
# Optional: fallback channel for scheduled task results
SLACK_LOG_CHANNEL=
# Optional: proactive default check-ins
PROACTIVE_ENABLED=false
PROACTIVE_CHANNEL=
PROACTIVE_TIMES_PER_DAY=4
PROACTIVE_WINDOW_START=09:00
PROACTIVE_WINDOW_END=22:00
PROACTIVE_MIN_GAP_MINUTES=120
PROACTIVE_TIMEZONE=Asia/Tokyo
