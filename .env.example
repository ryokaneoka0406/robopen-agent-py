SLACK_BOT_TOKEN=xoxb-***
SLACK_APP_TOKEN=xapp-***
# Optional: agent engine. Supported values: codex, claude
AGENT_ENGINE=codex
# Optional: override codex binary path/alias
CODEX_CMD=codex
# Optional: override Claude Code binary path/alias
CLAUDE_CMD=claude
# Optional: Claude Code permission mode for print mode
CLAUDE_PERMISSION_MODE=dontAsk
# Optional: comma-separated Claude Code tool allow/deny rules
CLAUDE_ALLOWED_TOOLS=
CLAUDE_DISALLOWED_TOOLS=
# Optional: SQLite database path
SQLITE_PATH=data/agent.db
# Optional: fallback channel for scheduled task results
SLACK_LOG_CHANNEL=
